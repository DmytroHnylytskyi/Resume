# ==============================================================================
# Production Environment Configuration Template
# Copy this file to .env on your VPS Droplet and update the values:
#   cp .env.production.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Global Domain & SSL Configuration
# ------------------------------------------------------------------------------
# Your custom domain registered through Namecheap / Student Pack (without https://)
DOMAIN=hnylytskyi.me

# Email address for Let's Encrypt automated TLS/SSL expiration notices
LETSENCRYPT_EMAIL=dmitrijgnilickij7@gmail.com

# ------------------------------------------------------------------------------
# 2. Forma-3D Configurator Secrets
# ------------------------------------------------------------------------------
FORMA_SECRET_KEY=generate-random-32-chars-key-for-forma3d-jwt-auth
FORMA_DB_USER=forma_user
FORMA_DB_PASSWORD=change-to-strong-unique-password-forma-db
FORMA_DB_NAME=forma_db

# ------------------------------------------------------------------------------
# 3. TerraScope 3D Geospatial Secrets
# ------------------------------------------------------------------------------
TERRASCOPE_SECRET_KEY=generate-random-32-chars-key-for-terrascope-jwt
# NASA NeoWs API Key (DEMO_KEY works, or get a free personal key at api.nasa.gov)
NASA_API_KEY=DEMO_KEY

# ------------------------------------------------------------------------------
# 4. Lumina LMS Platform Secrets
# ------------------------------------------------------------------------------
LUMINA_SECRET_KEY=generate-random-32-chars-key-for-lumina-lms-jwt
LUMINA_DB_USER=lumina_user
LUMINA_DB_PASSWORD=change-to-strong-unique-password-lumina-db
LUMINA_DB_NAME=lumina_db
# Cloudinary CDN URL (optional: leave empty for local container storage in /uploads)
CLOUDINARY_URL=
