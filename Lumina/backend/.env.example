DATABASE_URL=sqlite:///./sql_app.db
# Cloudinary (Replace with your actual keys)
CLOUDINARY_URL=cloudinary://<your_api_key>:<your_api_secret>@fceuscdn

# Security
# Both keys are REQUIRED (the server refuses to start without them).
# Never commit real keys. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
REFRESH_SECRET_KEY=
FRONTEND_URL=http://localhost:5173,https://your-vercel-app.vercel.app
